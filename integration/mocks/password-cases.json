    { "name": "A combined accent counts as one character", "password": "café au lait 1", "expected": { "level": "weak", "accepted": false, "reason": "tooShort" } },
    { "name": "Exactly 15 characters", "password": "violet piano 47", "expected": { "level": "strong", "accepted": true, "reason": null } },
    { "name": "Too long", "password": "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz", "expected": { "level": "weak", "accepted": false, "reason": "tooLong" } },
