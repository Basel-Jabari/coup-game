{
  "about": "Shared test passwords for integration/contracts/password-policy.json. Frontend and backend tests must give these exact results.",
  "cases": [
    { "name": "Too short", "password": "Short pass 1!", "expected": { "level": "weak", "accepted": false, "reason": "tooShort" } },
    { "name": "A combined accent counts as one character", "password": "Café au lait 1", "expected": { "level": "weak", "accepted": false, "reason": "tooShort" } },
    { "name": "Exactly 15 characters", "password": "Violet-Piano-47", "expected": { "level": "strong", "accepted": true, "reason": null } },
    { "name": "Too long", "password": "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz", "expected": { "level": "weak", "accepted": false, "reason": "tooLong" } },
    { "name": "No capital letter", "password": "violet piano 47!", "expected": { "level": "weak", "accepted": false, "reason": "noUpper" } },
    { "name": "No small letter", "password": "VIOLET PIANO 47!", "expected": { "level": "weak", "accepted": false, "reason": "noLower" } },
    { "name": "No number", "password": "Violet piano forty!", "expected": { "level": "weak", "accepted": false, "reason": "noNumber" } },
    { "name": "A space is not a symbol", "password": "Violet piano 47 47", "expected": { "level": "weak", "accepted": false, "reason": "noSymbol" } },
    { "name": "Only the listed symbols count", "password": "Violet piano 47€", "expected": { "level": "weak", "accepted": false, "reason": "noSymbol" } },
    { "name": "An emoji is not a symbol", "password": "Violet piano 47🙂", "expected": { "level": "weak", "accepted": false, "reason": "noSymbol" } },
    { "name": "A quote counts as a symbol", "password": "Violet \"piano\" 47", "expected": { "level": "strong", "accepted": true, "reason": null } },
    { "name": "A backslash counts as a symbol", "password": "Violet\\piano\\47", "expected": { "level": "strong", "accepted": true, "reason": null } },
    { "name": "Arabic digits are not 0-9", "password": "Violet piano ٤٧!", "expected": { "level": "weak", "accepted": false, "reason": "noNumber" } },
    { "name": "Arabic letters still need A-Z", "password": "كلمة سر طويلة جدا للعبة", "expected": { "level": "weak", "accepted": false, "reason": "noUpper" } },
    { "name": "Arabic words with all four types", "password": "كلمة سر Violet 47!", "expected": { "level": "strong", "accepted": true, "reason": null } },
    { "name": "The word Coup is allowed", "password": "Welcome to Coup 1!", "expected": { "level": "strong", "accepted": true, "reason": null } },
    { "name": "Contains the username", "password": "The PixelKnight rides 1!", "username": "PixelKnight", "expected": { "level": "weak", "accepted": false, "reason": "personal" } },
    { "name": "Contains the email name", "password": "Card.player wins 1 round", "email": "card.player@example.com", "expected": { "level": "weak", "accepted": false, "reason": "personal" } },
    { "name": "A 3-character username counts", "password": "Ace violet piano 47!", "username": "Ace", "expected": { "level": "weak", "accepted": false, "reason": "personal" } },
    { "name": "A username shorter than 3 characters is ignored", "password": "Always calm & very alert 1", "username": "Al", "expected": { "level": "strong", "accepted": true, "reason": null } },
    { "name": "An email name shorter than 3 characters is ignored", "password": "Jo plays violet piano 47!", "email": "jo@example.com", "expected": { "level": "strong", "accepted": true, "reason": null } },
    { "name": "Common password with capitals and symbols", "password": "P@ssw0rdSt@ndard", "expected": { "level": "weak", "accepted": false, "reason": "common" } },
    { "name": "Common keyboard pattern with all four types", "password": "Q@2wsxedcrfvtgb", "expected": { "level": "weak", "accepted": false, "reason": "common" } },
    { "name": "Weak keyboard pattern", "password": "Qwerty123456789!", "expected": { "level": "weak", "accepted": false, "reason": "weak" } },
    { "name": "Weak word and sequence", "password": "P@ssw0rd12345678", "expected": { "level": "weak", "accepted": false, "reason": "weak" } },
    { "name": "Fair", "password": "Summer2026!2026!", "expected": { "level": "fair", "accepted": true, "reason": null } },
    { "name": "Good", "password": "Football20262026!", "expected": { "level": "good", "accepted": true, "reason": null } },
    { "name": "Strong", "password": "Violet piano 47!", "expected": { "level": "strong", "accepted": true, "reason": null } }
  ]
}
