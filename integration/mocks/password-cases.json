    { "name": "Another common password with mixed capitals", "password": "pAsSwOrDsTaNdArD", "expected": { "level": "weak", "accepted": false, "reason": "common" } },
    { "name": "Repeated letters", "password": "aaaaaaaaaaaaaaaa", "expected": { "level": "weak", "accepted": false, "reason": "weak" } },
    { "name": "Weak", "password": "password12345678", "expected": { "level": "weak", "accepted": false, "reason": "weak" } },
    { "name": "Fair", "password": "football20262026", "expected": { "level": "fair", "accepted": true, "reason": null } },
    { "name": "Good", "password": "sunshine summer1", "expected": { "level": "good", "accepted": true, "reason": null } },
